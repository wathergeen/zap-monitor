# ==============================================================================
# CONFIGURAÇÕES DO MONITOR DE WHATSAPP (EVOLUTION API + DJANGO) - VERSÃO 2 ENXUTA
# Stack: 5 containers (proxy, web, worker, postgres, evolution). Sem Redis e sem Celery.
# ==============================================================================

# Ambiente e Django
DJANGO_SETTINGS_MODULE=core.settings.dev
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-strong-random-key-with-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Fuso horário padrão da aplicação (para cálculo de atividade mensal)
TIME_ZONE=America/Sao_Paulo

# Banco de Dados PostgreSQL 16 (Dados e Fila Procrastinate)
DB_NAME=zapbot_db
DB_USER=zapbot_user
DB_PASSWORD=zapbot_strong_password
DB_HOST=postgres
DB_PORT=5432

# Procrastinate Worker (concorrência ajustável)
WORKER_CONCURRENCY=4

# ==============================================================================
# CONEXÕES COM A EVOLUTION API (MULTI-BOT)
# As conexões com os bots/instâncias do WhatsApp são cadastradas e gerenciadas
# dinamicamente EXCLUSIVAMENTE pelo painel web (Configurações > Conexões / Bots da Evolution API).
# Nenhuma instância ou URL de bot deve ser fixada neste arquivo .env.
# ==============================================================================

# 2FA TOTP (Obrigatório em produção para administradores)
TOTP_ENFORCE_ADMIN=False

# Backend de Busca Textual (PostgreSQL FTS com índice GIN e unaccent)
SEARCH_BACKEND=postgres

# Sessão e Segurança
SESSION_COOKIE_AGE=1800
SESSION_MAX_AGE=43200
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Retenção e Alertas (LGPD & Observabilidade)
RETENTION_MONTHS=12
WEBHOOK_INACTIVITY_ALERT_HOURS=6
